/* 紧凑布局的样式 */
page {
  background: #f0f2f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  height: 100vh;
  width: 100vw;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 头部区域 */
.header-container {
  display: flex;
  align-items: center;
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  height: 85rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 100;
}

.header-left,
.header-right {
  width: 65rpx;
  flex-shrink: 0;
}

.header-center {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
}

.main-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
  margin-bottom: 2rpx;
}

.website {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.close-button,
.more-button {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  transition: all 0.3s ease;
}

.close-button:active,
.more-button:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.95);
}

.close-icon {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 300;
}

.more-icon {
  font-size: 34rpx;
  color: #ffffff;
}

/* 顶部菜单 */
.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  padding-top: 100rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.dropdown-menu {
  background: #ffffff;
  border-radius: 16rpx;
  width: 400rpx;
  margin-right: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  animation: slideInRight 0.3s ease;
}

@keyframes slideInRight {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

.menu-header {
  padding: 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.menu-close-btn {
  width: 45rpx;
  height: 45rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-btn-icon {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 300;
}

.menu-items {
  padding: 12rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 20rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:active {
  background-color: #f8f8f8;
}

.menu-item:last-child {
  border-bottom: none;
}

.item-icon-box {
  width: 50rpx;
  height: 50rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.item-icon {
  font-size: 26rpx;
  color: #ffffff;
}

.item-content {
  flex: 1;
}

.item-title {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* 主内容区域 */
.main-content-area {
  flex: 1;
  padding: 15rpx 0 15rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
  margin-bottom: 0;
}

/* 内容展示区 */
.simple-display-area {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 10rpx; /* 增加与缩略图的间距 */
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #e8e8e8;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: transform 0.3s ease;
  transform-origin: center center;
}

.simple-display-area.swipe-left {
  animation: swipeLeft 0.3s ease;
}

.simple-display-area.swipe-right {
  animation: swipeRight 0.3s ease;
}

@keyframes swipeLeft {
  0% { transform: translateX(0) scale(var(--scale, 1)) rotateY(0deg); opacity: 1; }
  50% { transform: translateX(-40rpx) scale(var(--scale, 1)) rotateY(5deg); opacity: 0.8; }
  100% { transform: translateX(0) scale(var(--scale, 1)) rotateY(0deg); opacity: 1; }
}

@keyframes swipeRight {
  0% { transform: translateX(0) scale(var(--scale, 1)) rotateY(0deg); opacity: 1; }
  50% { transform: translateX(40rpx) scale(var(--scale, 1)) rotateY(-5deg); opacity: 0.8; }
  100% { transform: translateX(0) scale(var(--scale, 1)) rotateY(0deg); opacity: 1; }
}

.display-content {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.book-image {
  width: 85%;
  height: 85%;
  object-fit: contain;
}

/* 页面指示器 */
.page-indicator {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.page-number {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}



/* 原始缩略图区域 */
.thumbnail-section {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
  margin-top: 5rpx;
  margin-bottom: 0rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #e0e0e0;
  flex-shrink: 0;
  height: 350rpx;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.thumbnail-scroll-view {
  width: 100%;
  white-space: nowrap;
  height: 150rpx;
}

.thumbnails-wrapper {
  display: inline-flex;
  padding: 25rpx 0;
  align-items: center;
  gap: 8rpx;
}

.thumbnail-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx;
  border-radius: 8rpx;
  background: #f8f9fa;
  transition: all 0.3s ease;
  min-width: 70rpx;
  flex-shrink: 0;
  border: 1rpx solid transparent;
}

.thumbnail-item:active {
  background: #e9ecef;
}

.thumbnail-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: #667eea;
}

.thumbnail-item.zoomed {
  transform: scale(1.15);
  z-index: 10;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.15);
}

.thumbnail-box {
  width: 75rpx;
  height: 100rpx;
  background: #ffffff;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8e8e8;
  position: relative;
  overflow: hidden;
}

.thumbnail-image {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  display: block;
}

.thumbnail-page {
  font-size: 20rpx;
  font-weight: 600;
  color: #333333;
  position: relative;
  z-index: 1;
  background-color: rgba(255, 255, 255, 0.85);
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
}

.thumbnail-item.active .thumbnail-page {
  color: #ffffff;
  background-color: rgba(102, 126, 234, 0.9);
}

.thumbnail-item.active .thumbnail-box {
  border-color: rgba(255, 255, 255, 0.3);
}

.thumbnail-item.zoomed .thumbnail-box {
  border-color: #667eea;
}

/* 底部功能栏 */
.combined-controls-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 15rpx;
  background: #ffffff;
  border-top: 1rpx solid #e0e0e0;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  height: 130rpx;
}

/* 跳转控制项 */
.jump-control-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5rpx 8rpx;
  min-width: 140rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.jump-box {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 18rpx;
  padding: 10rpx 15rpx;
  border: 1rpx solid #e8e8e8;
  justify-content: center;
  width: 100%;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.08);
}

.jump-label {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
  margin-right: 12rpx;
  white-space: nowrap;
}

.jump-input {
  width: 70rpx;
  height: 42rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333333;
  background: #ffffff;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  margin: 0 6rpx;
  line-height: 42rpx;
}

.slash {
  font-size: 22rpx;
  color: #999999;
  margin: 0 6rpx;
}

.total-label {
  font-size: 22rpx;
  color: #666666;
  margin: 0 8rpx;
  white-space: nowrap;
}

.jump-btn {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 8rpx;
  border: none;
  line-height: 1;
  min-width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  font-weight: 600;
}

.jump-btn:active {
  transform: scale(0.95);
}

/* 控制项通用样式 */
.control-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5rpx 6rpx;
  min-width: 65rpx;
  transition: all 0.3s ease;
  flex: 1;
}

.control-item:active {
  transform: scale(0.95);
}

/* 控制图标通用样式 */
.control-icon {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 5rpx;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

/* 缩略图切换按钮 */
.thumb-toggle {
  background: linear-gradient(135deg, #6a89cc 0%, #b8e994 100%);
}

.thumb-toggle.active {
  background: linear-gradient(135deg, #4a69bd 0%, #82ccdd 100%);
  transform: scale(1.05);
}

/* 智能缩放按钮 */
.smart-zoom {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.smart-zoom.zoomed {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  transform: scale(1.05);
}

/* 上传按钮 */
.upload-btn {
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
}

/* 功能菜单按钮 */
.menu-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.control-icon-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: bold;
}

.menu-dots {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-dot {
  width: 4rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 50%;
  margin: 1.5rpx 0;
}

.control-label {
  font-size: 18rpx;
  color: #333333;
  font-weight: 500;
  margin-top: 3rpx;
}

/* 文件上传菜单 */
.upload-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeIn 0.3s ease;
}

.upload-menu-content {
  background: #ffffff;
  border-radius: 25rpx;
  width: 650rpx;
  overflow: hidden;
  box-shadow: 0 25rpx 70rpx rgba(0, 0, 0, 0.4);
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.upload-header {
  padding: 35rpx 30rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.upload-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.upload-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-close-icon {
  font-size: 32rpx;
  color: #333333;
  font-weight: 300;
}

.upload-types {
  padding: 40rpx 30rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25rpx 20rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  transition: all 0.3s ease;
}

.type-item:active {
  background: #e9ecef;
  transform: scale(0.95);
}

.type-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.pdf-icon { background: #ff6b6b; }
.word-icon { background: #4ecdc4; }
.excel-icon { background: #45b7d1; }
.ppt-icon { background: #96ceb4; }
.image-icon { background: #feca57; }
.txt-icon { background: #ff9ff3; }

.type-icon-text {
  font-size: 40rpx;
  color: #ffffff;
}

.type-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.upload-hint {
  padding: 25rpx 30rpx;
  background: #f8f9fa;
  text-align: center;
  border-top: 1rpx solid #e8e8e8;
}

.upload-hint text {
  font-size: 24rpx;
  color: #666666;
}

/* 圆圈菜单 */
.circle-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-menu-content {
  background: #ffffff;
  border-radius: 25rpx;
  width: 650rpx;
  max-height: 80vh;
  overflow: hidden;
  box-shadow: 0 25rpx 70rpx rgba(0, 0, 0, 0.4);
}

.circle-menu-header {
  padding: 35rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.circle-menu-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.circle-close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-close-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 300;
}

.circle-menu-scroll {
  max-height: 60vh;
  padding: 0 30rpx;
}

.menu-section {
  margin: 35rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 25rpx;
}

.menu-section:first-child {
  margin-top: 25rpx;
}

.menu-section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 25rpx;
  padding-left: 5rpx;
}

.menu-row,
.switch-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  transition: background-color 0.2s;
  border-radius: 12rpx;
  padding-left: 15rpx;
  padding-right: 15rpx;
}

.menu-row:active,
.switch-row:active {
  background-color: #f8f8f8;
}

.menu-row:last-child,
.switch-row:last-child {
  border-bottom: none;
}

.row-icon {
  font-size: 34rpx;
  margin-right: 22rpx;
  width: 45rpx;
  text-align: center;
}

.row-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.row-arrow {
  font-size: 38rpx;
  color: #cccccc;
  margin-left: 15rpx;
}

.switch-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.switch-icon {
  font-size: 34rpx;
  margin-right: 22rpx;
  width: 45rpx;
  text-align: center;
}

.switch-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

switch {
  transform: scale(0.85);
}

/* 加载动画 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.loading-text {
  font-size: 28rpx;
  color: #667eea;
  margin-top: 20rpx;
}

/* 提示信息 */
.toast-custom {
  background: rgba(0, 0, 0, 0.8);
  color: white;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}